{% if backend == 'hcp' -%}
terraform {
  cloud {
    organization = "{{ hcp_org }}"

    workspaces {
      name = "cloudflare"
    }
  }
}
{%- elif state_backend == 'gcs' -%}
terraform {
  backend "gcs" {
    bucket = "{{ state_bucket }}"
    prefix = "{{ state_prefix }}/cloudflare"
  }
}
{%- elif state_backend == 's3' and state_endpoint -%}
terraform {
  backend "s3" {
    bucket = "{{ state_bucket }}"
    key    = "{{ state_prefix }}/cloudflare/terraform.tfstate"
    region = "{{ state_region }}"

    endpoints = {
      s3 = "{{ state_endpoint }}"
    }
    use_lockfile                = true
    use_path_style              = true
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}
{%- elif state_backend == 's3' -%}
terraform {
  backend "s3" {
    bucket         = "{{ state_bucket }}"
    key            = "{{ state_prefix }}/cloudflare/terraform.tfstate"
    region         = "{{ state_region }}"
    dynamodb_table = "{{ state_lock_table }}"
  }
}
{%- else -%}
terraform {
  backend "azurerm" {
    resource_group_name  = "{{ azure_resource_group }}"
    storage_account_name = "{{ azure_storage_account }}"
    container_name       = "{{ state_bucket }}"
    key                  = "{{ state_prefix }}/cloudflare/terraform.tfstate"
    use_azuread_auth     = true
  }
}
{%- endif %}
