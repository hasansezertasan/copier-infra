# >>> cobo:begin >>>
# Generated by cobo (github.com/hasansezertasan/cobo)
# editorconfig/Python@f64e011 — https://raw.githubusercontent.com/vinibrsl/editorconfig-templates/f64e011b04669db816b8075f3a9d4f3beb58c9d6/Python.editorconfig
root = true

[*]
insert_final_newline = true     

[*.{ini,py,py.tpl,rst}]
indent_style = space
indent_size = 4

[*.{sh,bat.tpl,Makefile.tpl}]
indent_style = tab
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2
# <<< cobo:end sha256=0589b011623af450096c4e13e02a2b9aa3553aefc55c6e0adef443c3943d55ae <<<

# Project overrides live below the fence, where cobo preserves them.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[*.{json,jsonc,md,toml}]
indent_size = 2

# cobo's sealed blocks carry upstream trailing whitespace; trimming it breaks the seal.
[{.gitignore,.gitattributes,.editorconfig}]
trim_trailing_whitespace = false

# `.lock` falls outside the TOML glob above.
[cobo.lock]
indent_size = 2

[*.{png,jpg,gif,ico,woff,woff2,ttf,eot,svg,pdf}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Markdown and YAML keep trailing whitespace (hard line breaks, block scalars).
[*.{md,yml,yaml}]
trim_trailing_whitespace = false
